PORT=5000
NODE_ENV=production

# Production MongoDB Atlas Connection String (or local MongoDB URI)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/dynamic_it?retryWrites=true&w=majority
AUTO_START_LOCAL_MONGOD=false

# Strong 64+ character random secret for production JWT signing (Required)
JWT_SECRET=replace_with_a_64_character_cryptographically_random_secret_key_for_production
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS & Socket.IO
CLIENT_URL=https://your-domain.com,https://www.your-domain.com
COOKIE_SAMESITE=none
SERVE_FRONTEND=false

# Initial Administrator Account (Created on first startup if no admin exists)
ADMIN_NAME=Dynamic IT Administrator
ADMIN_EMAIL=admin@dynamicit.com
ADMIN_PHONE=+880 1711-000111
ADMIN_INITIAL_PASSWORD=ChangeThisStrongPassword!2026
SEED_DEMO_DATA=false

# Persistent File Storage via Cloudinary (Required in production unless ALLOW_LOCAL_UPLOADS_IN_PROD=true)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Official bKash Tokenized Checkout Merchant Credentials
# Sandbox URL: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Production URL: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Official Nagad Payment Gateway Merchant Credentials
# Sandbox URL: http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# Automated Email Notifications (Nodemailer SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dynamic IT Studio" <no-reply@dynamicit.com>

# SMS Notification Gateway (SSLWireless / BulkSMSBD / Generic HTTP Gateway)
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=DynamicIT
